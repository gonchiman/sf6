{
  "name": "sf6-balance-analysis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test": "node --test src/lib/winRates.test.ts src/lib/totalWinRates.test.ts src/lib/characters.test.ts src/lib/routes.test.ts scripts/lib/character-snapshot.test.ts",
    "data:import-characters": "node scripts/import-character-data.ts",
    "validate:data": "node scripts/validate-win-rate-data.ts && node scripts/validate-character-data.ts",
    "build": "npm run validate:data && tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
